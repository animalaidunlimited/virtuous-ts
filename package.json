{
  "name": "virtuous-ts",
  "version": "1.0.1",
  "description": "Type-safe TypeScript client for the Virtuous CRM API: contacts, gifts, campaigns, projects, events, grants, volunteering, tasks, webhooks, query builders, and import/transaction endpoints.",
  "repository": {
    "type": "git",
    "url": "https://github.com/animalaidunlimited/virtuous-ts.git"
  },
  "homepage": "https://github.com/animalaidunlimited/virtuous-ts#readme",
  "bugs": {
    "url": "https://github.com/animalaidunlimited/virtuous-ts/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "echo '⚠️  WARNING: test:all hits LIVE Virtuous CRM data (creates/modifies contacts, gifts, etc). Requires VIRTUOUS_API_KEY. Not suitable for CI. Use npm run test:unit for mocks, or npm run test:read-only for live GETs and Query/Search only.'",
    "test:unit": "VITEST_UNIT_ONLY=1 vitest run tests/unit",
    "test:read-only": "vitest run --config vitest.read-only.config.mts",
    "test:all": "vitest run 01 02 03 04 05",
    "test:watch": "vitest watch",
    "test:ui": "vitest 01 02 03 04 05 --ui",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "virtuous",
    "crm",
    "api",
    "typescript",
    "nonprofit",
    "donations",
    "fundraising",
    "sdk",
    "api-client"
  ],
  "author": "Spencer Hardy",
  "contributors": [
    "Animal Aid Unlimited <info@animalaidunlimited.com> (https://www.animalaidunlimited.com/)"
  ],
  "license": "MIT",
  "type": "commonjs",
  "sideEffects": false,
  "dependencies": {
    "axios": "^1.20.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "dotenv": "^17.4.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
